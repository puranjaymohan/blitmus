/*****/

/* Quiet libbpf's debug chatter; surface warnings and errors. */
static int libbpf_print_fn(enum libbpf_print_level level, const char *format,
			   va_list args)
{
	if (level == LIBBPF_DEBUG)
		return 0;
	return vfprintf(stderr, format, args);
}

struct worker_args {
	int cpu;
	int prog_fd;
	pthread_barrier_t *barrier;
	int err;
};

/* Run one process's BPF program pinned to @cpu via BPF_PROG_TEST_RUN. */
static void *worker(void *arg)
{
	struct worker_args *a = arg;
	cpu_set_t cpuset;
	struct bpf_test_run_opts opts = {
		.sz = sizeof(opts),
		.flags = BPF_F_TEST_RUN_ON_CPU,
		.cpu = a->cpu,
	};

	CPU_ZERO(&cpuset);
	CPU_SET(a->cpu, &cpuset);
	if (sched_setaffinity(0, sizeof(cpuset), &cpuset))
		perror("sched_setaffinity");

	/* Release all processes as close together as possible. */
	pthread_barrier_wait(a->barrier);

	/*
	 * A process that did not run leaves its result slots zeroed, which
	 * would count as negatives: report it so the round is not counted.
	 */
	a->err = bpf_prog_test_run_opts(a->prog_fd, &opts);
	if (a->err)
		fprintf(stderr, "BPF_PROG_TEST_RUN on CPU %d: %s\n",
			a->cpu, strerror(errno));
	return NULL;
}

/* Zero the shared state (variables, result slots, and the sense barrier). */
static void reset_state(STRUCT_NAME(TEST_NAME) *skel)
{
	memset(skel->bss, 0, sizeof(*skel->bss));
}

/*
 * Choose THREADS distinct online CPUs at random (Fisher-Yates).  srand() is
 * seeded once by the caller; picking fresh CPUs each run samples many
 * hardware pairs over the course of a test.
 */
static int pick_random_cpus(int *cpus)
{
	cpu_set_t online;
	int all[CPU_SETSIZE], n = 0, i;

	CPU_ZERO(&online);
	if (sched_getaffinity(0, sizeof(online), &online)) {
		perror("sched_getaffinity");
		return -1;
	}
	for (i = 0; i < CPU_SETSIZE; i++)
		if (CPU_ISSET(i, &online))
			all[n++] = i;

	if (n < THREADS) {
		fprintf(stderr, "need %d CPUs, only %d online\n", THREADS, n);
		return -1;
	}
	for (i = n - 1; i > 0; i--) {
		int j = rand() % (i + 1), tmp = all[i];

		all[i] = all[j];
		all[j] = tmp;
	}
	for (i = 0; i < THREADS; i++)
		cpus[i] = all[i];
	return 0;
}

static void print_usage(const char *prog)
{
	printf("Usage: %s [OPTIONS]\n", prog);
	printf("Options:\n");
	printf("  -i, --iterations NUM   Test rounds (default: %d); each round runs\n"
	       "                         the litmus code %d times\n",
	       DEFAULT_ITERATIONS, BLITMUS_SLOTS);
	printf("  -v, --verbose          Print progress\n");
	printf("  -h, --help             Show this help\n");
}

int main(int argc, char **argv)
{
	STRUCT_NAME(TEST_NAME) *skel;
	struct bpf_program *prog;
	int iterations = DEFAULT_ITERATIONS, verbose = 0;
	unsigned long long matches = 0, non_matches = 0;
	int prog_fds[THREADS], cpus[THREADS], nr_progs = 0, reset_fd = -1;
	struct worker_args args[THREADS];
	pthread_t t[THREADS];
	pthread_barrier_t barrier;
	struct timespec start, end;
	int opt, err = 0;

	static const struct option long_options[] = {
		{ "iterations", required_argument, 0, 'i' },
		{ "verbose",    no_argument,       0, 'v' },
		{ "help",       no_argument,       0, 'h' },
		{ 0, 0, 0, 0 }
	};

	while ((opt = getopt_long(argc, argv, "i:vh", long_options, NULL)) != -1) {
		switch (opt) {
		case 'i':
			iterations = atoi(optarg);
			break;
		case 'v':
			verbose = 1;
			break;
		case 'h':
			print_usage(argv[0]);
			return 0;
		default:
			print_usage(argv[0]);
			return 1;
		}
	}
	if (iterations <= 0) {
		fprintf(stderr, "iterations must be > 0\n");
		return 1;
	}

	srand(time(NULL) ^ (getpid() << 16));

	libbpf_set_print(libbpf_print_fn);

	skel = BPF_OPEN(TEST_NAME)();
	if (!skel) {
		fprintf(stderr, "failed to open BPF skeleton\n");
		return 1;
	}
	err = BPF_LOAD(TEST_NAME)(skel);
	if (err) {
		fprintf(stderr, "failed to load/verify BPF skeleton\n");
		goto cleanup;
	}

	bpf_object__for_each_program(prog, *skel->skeleton->obj) {
		/* reset() is not a process: it runs once per round (below). */
		if (!strcmp(bpf_program__name(prog), "handle_reset")) {
			reset_fd = bpf_program__fd(prog);
			continue;
		}
		if (nr_progs >= THREADS) {
			fprintf(stderr, "more BPF programs than THREADS (%d)\n", THREADS);
			err = -1;
			goto cleanup;
		}
		prog_fds[nr_progs] = bpf_program__fd(prog);
		if (prog_fds[nr_progs] < 0) {
			fprintf(stderr, "failed to get program fd\n");
			err = -1;
			goto cleanup;
		}
		nr_progs++;
	}
	if (nr_progs != THREADS) {
		fprintf(stderr, "expected %d BPF programs, found %d\n", THREADS, nr_progs);
		err = -1;
		goto cleanup;
	}

	printf("Starting litmus test with configuration:\n");
	printf("  Test: %s\n", TEST_NAME_PRINT);
	printf("  Iterations: %d\n", iterations);

	if (pthread_barrier_init(&barrier, NULL, THREADS)) {
		fprintf(stderr, "failed to init barrier\n");
		err = -1;
		goto cleanup;
	}

	clock_gettime(CLOCK_MONOTONIC, &start);
	for (int it = 0; it < iterations; it++) {
		reset_state(skel);
		if (reset_fd >= 0) {
			/* Free last round's pages (deferred) + clear arena state. */
			struct bpf_test_run_opts ro = { .sz = sizeof(ro) };

			if (bpf_prog_test_run_opts(reset_fd, &ro)) {
				fprintf(stderr, "BPF_PROG_TEST_RUN of reset: %s\n",
					strerror(errno));
				err = -1;
				goto destroy_barrier;
			}
		}
		if (pick_random_cpus(cpus)) {
			err = -1;
			goto destroy_barrier;
		}
		for (int p = 0; p < THREADS; p++) {
			args[p] = (struct worker_args){ cpus[p], prog_fds[p], &barrier, 0 };
			if (pthread_create(&t[p], NULL, worker, &args[p])) {
				fprintf(stderr, "failed to create worker thread\n");
				exit(1);
			}
		}
		for (int p = 0; p < THREADS; p++) {
			pthread_join(t[p], NULL);
			if (args[p].err)
				err = -1;
		}
		if (err)
			goto destroy_barrier;

		for (int c = 0; c < BLITMUS_SLOTS; c++)
			check_cond(skel, &matches, &non_matches, c);

		if (verbose && it && it % (iterations / 10 ? iterations / 10 : 1) == 0) {
			printf("\r  %d/%d rounds - positive: %llu       ",
			       it, iterations, matches);
			fflush(stdout);
		}
	}
	clock_gettime(CLOCK_MONOTONIC, &end);

destroy_barrier:
	pthread_barrier_destroy(&barrier);
	if (err)
		goto cleanup;

	double elapsed = (end.tv_sec - start.tv_sec) +
			 (end.tv_nsec - start.tv_nsec) / 1e9;

	printf("\nTest %s Allowed\n", TEST_NAME_PRINT);
	print_histogram();
	printf("%s\n\n", matches > 0 ? "Ok" : "No");

	printf("Witnesses\n");
	printf("Positive: %llu, Negative: %llu\n", matches, non_matches);
	printf("Condition exists (%s) is %svalidated\n", EXISTS_CLAUSE,
	       matches > 0 ? "" : "NOT ");

	const char *observation = matches == 0 ? "Never" :
				  non_matches == 0 ? "Always" : "Sometimes";
	printf("Observation %s %s %llu %llu\n", TEST_NAME_PRINT, observation,
	       matches, non_matches);
	printf("Time %s %.2f\n\n", TEST_NAME_PRINT, elapsed);

	/*
	 * Return non-zero only when the hardware is WEAKER than LKMM permits:
	 *   Never     - the forbidden outcome must never happen.
	 *   Always    - the required outcome must happen every time.
	 *   Sometimes - any observation is fine (stronger than LKMM is allowed).
	 */
	switch (result_kind) {
	case RESULT_NEVER:
		err = matches > 0;
		break;
	case RESULT_ALWAYS:
		err = non_matches > 0;
		break;
	default:
		err = 0;
		break;
	}

cleanup:
	BPF_DESTROY(TEST_NAME)(skel);
	return err;
}
