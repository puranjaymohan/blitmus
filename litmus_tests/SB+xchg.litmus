C SB+xchg

(*
 * Result: Never
 *
 * Store-buffering where each thread's store is a value-returning xchg().
 * A value-returning RMW is fully ordered in LKMM (like smp_mb), so it
 * orders the store ahead of the later load and forbids the SB outcome.
 * Exercises the BPF_XCHG JIT path (arm64: SWPAL, or LL/SC LDXR+STLXR+DMB).
 *
 * blitmus: arena
 *)

{}

P0(int *x, int *y)
{
	int r0;

	xchg(x, 1);
	r0 = READ_ONCE(*y);
}

P1(int *x, int *y)
{
	int r0;

	xchg(y, 1);
	r0 = READ_ONCE(*x);
}

exists (0:r0=0 /\ 1:r0=0)
